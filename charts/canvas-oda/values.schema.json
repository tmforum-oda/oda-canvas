{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "api-operator-istio": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["enabled"]
      },
      "kong-gateway-install": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["enabled"]
      },
      "apisix-gateway-install": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["enabled"]
      },
      "dependentapi-simple-operator": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["enabled"]
      },
      "dependency-management-keycloak-authz": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["enabled"]
      }
    },
    "allOf": [
      {
        "oneOf": [
          {
            "properties": {
              "api-operator-istio": {
                "properties": {
                  "enabled": { "const": true }
                }
              },
              "kong-gateway-install": {
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "apisix-gateway-install": {
                "properties": {
                  "enabled": { "const": false }
                }
              }
            }
          },
          {
            "properties": {
              "api-operator-istio": {
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "kong-gateway-install": {
                "properties": {
                  "enabled": { "const": true }
                }
              },
              "apisix-gateway-install": {
                "properties": {
                  "enabled": { "const": false }
                }
              }
            }
          },
          {
            "properties": {
              "api-operator-istio": {
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "kong-gateway-install": {
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "apisix-gateway-install": {
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        ],
        "errorMessage": "Only one of api-operator-istio.enabled, kong-gateway-install.enabled, or apisix-gateway-install.enabled must be true."
      },
      {
        "oneOf": [
          {
            "properties": {
              "dependentapi-simple-operator": {
                "properties": {
                  "enabled": { "const": true }
                }
              },
              "dependency-management-keycloak-authz": {
                "properties": {
                  "enabled": { "const": false }
                }
              }
            }
          },
          {
            "properties": {
              "dependentapi-simple-operator": {
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "dependency-management-keycloak-authz": {
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        ],
        "errorMessage": "Exactly one of dependentapi-simple-operator.enabled or dependency-management-keycloak-authz.enabled must be true."
      }
    ]
  }
  