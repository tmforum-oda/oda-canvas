FROM python:3.12-alpine

RUN pip install --no-cache-dir \
    kopf==1.37.2 \
    kubernetes==27.2.0 \
    python-json-logger==2.0.7 \
    PyYAML \
    requests \
    Jinja2

COPY ./dependencyManagementKeycloakAuthzOperator.py /operator/
COPY ./keycloakUtils.py /operator/
COPY ./log_wrapper.py /operator/
COPY ./service_inventory_client.py /operator/
COPY ./utils.py /operator/
COPY ./templates /operator/templates/

ARG CICD_BUILD_TIME
ENV CICD_BUILD_TIME=$CICD_BUILD_TIME

ARG GIT_COMMIT_SHA
ENV GIT_COMMIT_SHA=$GIT_COMMIT_SHA

WORKDIR /operator

CMD ["/bin/sh", "-c", "kopf run -n $POD_NAMESPACE --verbose /operator/dependencyManagementKeycloakAuthzOperator.py"]
